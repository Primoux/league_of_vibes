{
  "_comment": "Source de vérité du découpage de League of Vibes. Le scope du titre de PR (commit conventionnel) désigne l'area. Vérifié par scripts/check-areas.mjs en CI.",
  "contracts": [
    "crates/lov-shared/Cargo.toml",
    "crates/lov-shared/src/lib.rs",
    "crates/lov-shared/src/protocol.rs",
    "crates/lov-shared/src/types.rs",
    "crates/lov-shared/src/schema.rs",
    "crates/lov-shared/src/constants.rs",
    "crates/lov-shared/src/map.rs",
    "crates/lov-shared/src/math.rs",
    "crates/lov-sim/src/systems/registry.rs"
  ],
  "always": [
    "docs/**/*.md",
    "Cargo.lock"
  ],
  "tests": [
    "crates/*/tests/**"
  ],
  "areas": {
    "champion": {
      "desc": "Tranche verticale : UN champion de bout en bout (données, sorts serveur, modèle 3D, FX, sons).",
      "vertical": "champion",
      "paths": [
        "crates/lov-shared/src/data/champions/*.rs",
        "crates/lov-sim/src/abilities/champions/*.rs",
        "crates/lov-client/src/render/champions/models/*.rs",
        "crates/lov-client/src/fx/champions/*.rs",
        "crates/lov-shared/src/data/mod.rs"
      ]
    },
    "net": {
      "desc": "Serveur : WebSocket, salles, draft, boucle de simulation, snapshots.",
      "paths": [
        "crates/lov-server/src/**",
        "crates/lov-sim/src/lib.rs",
        "crates/lov-sim/src/world.rs",
        "crates/lov-server/examples/**"
      ]
    },
    "nav": {
      "desc": "Serveur : pathfinding et navigation sur la carte.",
      "paths": [
        "crates/lov-sim/src/nav/**"
      ]
    },
    "combat": {
      "desc": "Serveur : dégâts, résistances, soins, boucliers, mort.",
      "paths": [
        "crates/lov-sim/src/combat/**"
      ]
    },
    "abilities": {
      "desc": "Serveur : moteur de sorts, buffs, CC, XP (hors kits de champions).",
      "paths": [
        "crates/lov-sim/src/abilities/*.rs",
        "crates/lov-shared/src/data/buffs.rs",
        "crates/lov-shared/src/data/summoners.rs",
        "crates/lov-shared/src/data/mod.rs"
      ]
    },
    "items": {
      "desc": "Serveur : objets, or, boutique, effets passifs et actifs.",
      "paths": [
        "crates/lov-sim/src/items/**",
        "crates/lov-shared/src/data/items.rs",
        "crates/lov-shared/src/data/mod.rs"
      ]
    },
    "systems": {
      "desc": "Serveur : systèmes de jeu (vision, régénération, respawn, minions, tours, nexus…).",
      "paths": [
        "crates/lov-sim/src/systems/*.rs",
        "crates/lov-shared/src/data/structures.rs",
        "crates/lov-shared/src/data/minions.rs",
        "crates/lov-shared/src/data/mod.rs"
      ]
    },
    "world-ai": {
      "desc": "Serveur : IA du monde PvE (jungle, drakes, Léviathan, Colosse, larves).",
      "paths": [
        "crates/lov-sim/src/world_ai/**",
        "crates/lov-shared/src/data/monsters.rs",
        "crates/lov-shared/src/data/mod.rs"
      ]
    },
    "render": {
      "desc": "Client : moteur 3D, caméra, vues, modèles génériques.",
      "paths": [
        "crates/lov-client/src/main.rs",
        "crates/lov-client/src/render/*.rs",
        "crates/lov-client/src/render/*.wesl",
        "crates/lov-client/src/render/views/**",
        "crates/lov-client/src/render/models/**"
      ]
    },
    "render-map": {
      "desc": "Client : rendu de la carte, terrain, décor.",
      "paths": [
        "crates/lov-client/src/render/map/**"
      ]
    },
    "render-champions": {
      "desc": "Client : socle des champions — animations, portraits, assemblage des modèles.",
      "paths": [
        "crates/lov-client/src/render/champions/*.rs",
        "crates/lov-client/src/render/champions/*.wesl",
        "crates/lov-client/src/render/champions/anim/**",
        "crates/lov-client/src/render/champions/portrait/**"
      ]
    },
    "fx-core": {
      "desc": "Client : socle FX — particules, post-traitement, shaders, FxBus.",
      "paths": [
        "crates/lov-client/src/fx/*.rs",
        "crates/lov-client/src/fx/core/**",
        "crates/lov-client/src/fx/particles/**",
        "crates/lov-client/src/fx/post/**",
        "crates/lov-client/src/fx/shaders/**"
      ]
    },
    "fx-effects": {
      "desc": "Client : effets de jeu — télégraphes, effets du monde, statuts.",
      "paths": [
        "crates/lov-client/src/fx/effects/**",
        "crates/lov-client/src/fx/telegraph/**",
        "crates/lov-client/src/fx/world/**",
        "crates/lov-client/src/fx/lab/**"
      ]
    },
    "audio": {
      "desc": "Client : musique, sons, mixage.",
      "paths": [
        "crates/lov-client/src/audio/**"
      ]
    },
    "ui-screens": {
      "desc": "UI : accueil, salon, draft, fin de partie, boutique.",
      "paths": [
        "crates/lov-client/src/ui/screens/**"
      ]
    },
    "ui-hud": {
      "desc": "UI : HUD en jeu — barres, sorts, minimap, panneaux.",
      "paths": [
        "crates/lov-client/src/ui/hud/**"
      ]
    },
    "ui-core": {
      "desc": "UI : socle Bevy UI, icônes, logique partagée, atelier.",
      "paths": [
        "crates/lov-client/src/ui/*.rs",
        "crates/lov-client/src/ui/icons/**",
        "crates/lov-client/src/ui/logic/**"
      ]
    },
    "input": {
      "desc": "Client : clavier, souris, mode jeu, raccourcis.",
      "paths": [
        "crates/lov-client/src/input/**"
      ]
    },
    "client-net": {
      "desc": "Client : connexion, interpolation, store d'état.",
      "paths": [
        "crates/lov-client/src/net/**",
        "crates/lov-client/src/state.rs"
      ]
    },
    "infra": {
      "desc": "Outillage : CI, publication, scripts, configuration, dépendances (et l'ancienne version TypeScript, retirée à la bascule).",
      "paths": [
        ".github/**",
        "scripts/**",
        "Dockerfile",
        ".nvmrc",
        ".gitignore",
        "*.md",
        ".dockerignore",
        "Cargo.toml",
        "rust-toolchain.toml",
        "rustfmt.toml",
        "crates/*/Cargo.toml",
        "packages/**",
        "package.json",
        "package-lock.json",
        "tsconfig*.json",
        "vitest.config.ts"
      ]
    },
    "docs": {
      "desc": "Documentation seule.",
      "paths": [
        "docs/**",
        "*.md"
      ]
    }
  }
}
